layout {
    default_tab_template {
        // Show the tab bar
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Oktowai" focus=true {
        pane name="Oktowai" borderless=false
    }
    tab name="Oktowai AI" {
        pane name="Oktowai AI" borderless=false
    }
    tab name="Frontend" {
        pane name="Frontend" borderless=false
    }
    tab name="Frontend AI" {
        pane name="Frontend AI" borderless=false
    }
}
