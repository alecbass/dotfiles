layout {
    default_tab_template {
        // Show the tab bar
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Backend Run" focus=true {
        pane name="Oktowai" borderless=false
    }
    tab name="Frontend Run" {
        pane name="Oktowai AI" borderless=false
    }
    tab name="Backend" {
        pane name="Oktowai AI" borderless=false
    }
    tab name="Backend AI" {
        pane name="Frontend" borderless=false
    }
    tab name="Backend AI 2" {
        pane name="Frontend AI" borderless=false
    }
    tab name="Frontend" {
        pane name="Frontend" borderless=false
    }
    tab name="Frontend AI" {
        pane name="Frontend AI" borderless=false
    }
    tab name="Frontend AI 2" {
        pane name="Oktowai" borderless=false
    }
}
