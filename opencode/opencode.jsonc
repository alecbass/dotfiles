{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
      {"action": "*", "resource": "*", "effect": "ask"},
      {"action": "read", "resource": "*", "effect": "allow"},
      {"action": "read", "resource": "*.env", "effect": "deny"},
      {"action": "read", "resource": "*.env.*", "effect": "deny"},
      {"action": "glob", "resource": "*", "effect": "allow"},
      {"action": "edit", "resource": "*", "effect": "allow"},
      {"action": "webfetch", "resource": "*", "effect": "allow"},
      {"action": "skill", "resource": "*", "effect": "allow"},
      {"action": "doom_Loop", "resource": "*", "effect": "ask"},
      {"action": "external_directory", "resource": "*", "effect": "ask"},
      // Linux
      {"action": "shell", "resource": "*", "effect": "ask"},
      {"action": "shell", "resource": "ls *", "effect": "ask"},
      {"action": "shell", "resource": "cat *", "effect": "ask"},
      {"action": "shell", "resource": "grep *", "effect": "ask"},
      {"action": "shell", "resource": "find *", "effect": "ask"},
      {"action": "shell", "resource": "head *", "effect": "ask"},
      {"action": "shell", "resource": "tail *", "effect": "ask"},
      {"action": "shell", "resource": "rg *", "effect": "ask"},
      {"action": "shell", "resource": "sed *", "effect": "ask"},
      {"action": "shell", "resource": "wc *", "effect": "ask"},
      {"action": "shell", "resource": "touch *", "effect": "ask"},
      {"action": "shell", "resource": "mkdir *", "effect": "ask"},
      {"action": "shell", "resource": "rm *", "effect": "ask"},
      {"action": "shell", "resource": "cp *", "effect": "ask"},
      {"action": "shell", "resource": "mv *", "effect": "ask"},
      {"action": "shell", "resource": "dd *", "effect": "ask"},
      {"action": "shell", "resource": "sudo *", "effect": "ask"},
      {"action": "shell", "resource": "chmod *", "effect": "ask"},
      {"action": "shell", "resource": "chown *", "effect": "ask"},
      {"action": "shell", "resource": "curl *", "effect": "ask"},
      {"action": "shell", "resource": "wget *", "effect": "ask"},
      {"action": "shell", "resource": "pip install *", "effect": "ask"},
      {"action": "shell", "resource": "kill *", "effect": "ask"},
      {"action": "shell", "resource": "killall *", "effect": "ask"},
      {"action": "shell", "resource": "pkill *", "effect": "ask"},
      {"action": "shell", "resource": "docker *", "effect": "ask"},
      {"action": "shell", "resource": "mkfs *", "effect": "ask"},
      {"action": "shell", "resource": "fdisk *", "effect": "ask"},
      {"action": "shell", "resource": "parted *", "effect": "ask"},
      {"action": "shell", "resource": "format *", "effect": "ask"},
      {"action": "shell", "resource": "ssh *", "effect": "ask"},
      {"action": "shell", "resource": "scp *", "effect": "ask"},
      {"action": "shell", "resource": "rsync *", "effect": "ask"},
      {"action": "shell", "resource": "reboot *", "effect": "deny"},
      {"action": "shell", "resource": "shutdown *", "effect": "deny"},
      // Git
      {"action": "shell", "resource": "git branch *", "effect": "allow"},
      {"action": "shell", "resource": "git status *", "effect": "allow"},
      {"action": "shell", "resource": "git log *", "effect": "allow"},
      {"action": "shell", "resource": "git show *", "effect": "allow"},
      {"action": "shell", "resource": "git merge-base *", "effect": "allow"},
      {"action": "shell", "resource": "git diff *", "effect": "allow"},
      {"action": "shell", "resource": "git remote *", "effect": "allow"},
      {"action": "shell", "resource": "git rev-parse*", "effect": "allow"},
      {"action": "shell", "resource": "git grep *", "effect": "allow"},
      {"action": "shell", "resource": "git push *", "effect": "ask"},
      {"action": "shell", "resource": "git reset *", "effect": "ask"},
      {"action": "shell", "resource": "git clean *", "effect": "ask"},
      {"action": "shell", "resource": "git branch -d *", "effect": "ask"},
      {"action": "shell", "resource": "git branch -D *", "effect": "ask"},
      {"action": "shell", "resource": "git merge *", "effect": "ask"},
      {"action": "shell", "resource": "git rebase *", "effect": "ask"},
      // GitHub
      {"action": "shell", "resource": "gh *", "effect": "deny"},
      // Rust
      {"action": "shell", "resource": "cargo check *", "effect": "allow"},
      // JS
      {"action": "shell", "resource": "npm install *", "effect": "allow"},
      {"action": "shell", "resource": "npm run publish *", "effect": "ask"},
      {"action": "shell", "resource": "pnpm install *", "effect": "allow"},
      {"action": "shell", "resource": "pnpm vitest *", "effect": "allow"},
  ],
  "default_agent": "plan"
}
