{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.local": "allow"
    }, 
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "webfetch": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",

      // Linux
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "wc *": "allow",
      "touch *": "ask",
      "mkdir *": "ask",
      "rm *": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "dd *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "pip install *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "docker *": "ask",
      "mkfs *": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "format *": "ask",
      "brew install *": "ask",
      "brew upgrade *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "reboot": "deny",
      "shutdown": "deny",

      // Git
      "git branch *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git merge-base *": "allow",
      "git diff *": "allow",
      "git remote *": "allow",
      "git rev-parse *": "allow",
      "git push": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git branch -d *": "ask",
      "git branch -D *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",

      // GitHub
      "gh *": "deny",

      // Rust
      "cargo check *": "allow",

      // JS
      "npm install *": "ask",
      "npm run publish": "ask",
      "pnpm vitest *": "allow"
    },
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "default_agent": "plan",
}
